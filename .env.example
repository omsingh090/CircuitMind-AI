# ==============================================================================
# CircuitMind AI - Environment Configuration Example
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# Google Gemini LLM Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/processed/chromadb
CHROMA_COLLECTION_NAME=datasheets

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI Settings
STREAMLIT_SERVER_PORT=8501
CIRCUITMIND_API_URL=http://127.0.0.1:8000
